function auth_password_verify(request, password)
	local auth_success = false
	local config

	if (request.domain == nil) then
		return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, "No domain provided."
	else
		config = getDomainConfig(request.domain)
		if (config == nil) then
			return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'Unknown domain: '..request.domain
		end
	end

	local sqlUserDetails = getUserDetailsSQL(request.user)

	if (sqlUserDetails == nil and config.allow_primary_password == 1) then
		sqlUserDetails = getPrimaryUserDetailsSQL(request.user, config.allow_primary_password)

		if (sqlUserDetails == nil and config.backend_type == 'MySQL') then
			return dovecot.auth.PASSDB_RESULT_USER_UNKNOWN, 'Unknown user: '..request.user
		end
	end

	if (sqlUserDetails ~= nil and sqlUserDetails.mail_password_hash ~= '') then
		local crypt = require 'crypt'
		if (crypt == nil) then
			return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'Failed to load crypt.'
		end
		if (crypt.check(password, sqlUserDetails.mail_password_hash)) then
			auth_success = true
		end
	end

	-- Disabled/active should only be returned to users with valid credentials and not before that since it would leak information otherwise.
	if (auth_success == true and (config.backend_type == 'MySQL' or (config.backend_type == 'LDAP' and config.ldap_sync_cron == 1)) and sqlUserDetails.active == 0) then
		return dovecot.auth.PASSDB_RESULT_USER_DISABLED, 'User '..request.user..' is disabled.'
	end

	if (config.backend_type == 'LDAP') then
		ldap = require "lualdap"
		ldh, err = ldap.open_simple (config.backend_uri, config.ldap_bind_dn, config.ldap_bind_password, true)
		if (ldh == nil) then
			return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'LDAP open_simple failed: '..err
		end
	end 

	-- System users are assumed to only exist in the database, or at a different base and disabled thus this check is irrelevant.
	if (config.backend_type == 'LDAP' and auth_success == true and config.ldap_sync_cron == 0 and sqlUserDetails.system_user == 0) then
		local ldapData = ldapSearch(config.ldap_base_dn, 'subtree', {'uid', 'nsaccountlock'}, 'mail='..sqlUserDetails.email)

		if (ldapData == nil or #ldapData == 0) then
			return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'No matching LDAP records returned or LDAP failure.'
		end

		for i=1, #ldapData do
			local usernameStart = string.find(sqlUserDetails.email, ldapData[i].uid, 1, true)
			local usernameLength = string.len(ldapData[i].uid)
			local firstAt = string.find(sqlUserDetails.email, '@', 1, true)

			if (usernameStart == 1 and (usernameStart + usernameLength) == firstAt) then
				if (ldapData[i].nsaccountlock) then
					return dovecot.auth.PASSDB_RESULT_USER_DISABLED, 'User disabled: '..request.user
				end

				break
			end
		end
	end

	local ldapUserInfo
	if (config.backend_type == 'LDAP' and auth_success == false and config.allow_primary_password == 1 and sqlUserDetails.system_user == 0) then
		local ldapData = ldapSearch(config.ldap_base_dn, 'subtree', {'uid'}, 'mail='..request.user)

		if (ldapData == nil or #ldapData == 0) then
			return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'No matching LDAP records returned or LDAP failure.'
		end

		for i=1, #ldapData do
			local usernameStart, usernameEnd = string.find(request.user, ldapData[i].uid, 1, true)
			local usernameLength = string.len(ldapData[i].uid)
			local firstAt = string.find(request.user, '@', 1, true)

			if (usernameStart == 1 and (usernameStart + usernameLength) == firstAt) then
				local conn, err	= ldh:bind_simple(ldapData[i].dn, password)

				if (conn == nil) then
					return dovecot.auth.PASSDB_RESULT_USER_DISABLED, 'User disabled: '..request.user..'\nLDAP Error: '..err
				else
					auth_success = true
					ldapUserInfo = ldapData[i]
					
					break
				end
			end
		end
	end

	if (auth_success and sqlUserDetails ~= nil) then
		writeLog(sqlUserDetails, request)
		return dovecot.auth.PASSDB_RESULT_OK, 'user='..sqlUserDetails.email
	end
	if (auth_success and ldapUserInfo ~= nil) then
		-- Create virtual_users entry and write log??
		--
		-- if(config.create_users) then
		--	createUser()
		--	getPrimaryUserDetailsSQL()
		--	writelog()
		--
		-- Alternative: send mail to sysadmin/user to encourage registration in mgmt interface
		-- Also only relevant when primary password is allowed.
		-- 
		-- All in all cron sync to db is probably the cleanest/best
		return dovecot.auth.PASSDB_RESULT_OK, 'user='..request.user
	end

	return dovecot.auth.PASSDB_RESULT_INTERNAL_FAILURE, 'Reached end with no decision'
end

function auth_userdb_lookup(request)
	local config

	if (request.domain == nil) then
		return dovecot.auth.USERDB_RESULT_INTERNAL_FAILURE, 'No domain provided.'
	else
		config = getDomainConfig(request.domain)
		if (config == nil) then
			return dovecot.auth.USERDB_RESULT_INTERNAL_FAILURE, 'Unknown domain: '..request.domain
		end
	end

	local localMail = dereferenceAlias(request.user)

	if (	localMail ~= nil 
		and (
			config.backend_type == 'MySQL' 
			or (	config.backend_type == 'LDAP' 
				and (	config.ldap_sync_cron == 1 
					or localMail.system_user == 1
				)
			)
		) and localMail.active == 1) then
		return dovecot.auth.USERDB_RESULT_OK, 'uid=mail gid=mail user='..localMail.email
	end

	if (localMail ~= nil) then
		request.user = localMail.email
	end

	local sqlUserDetails = getPrimaryUserDetailsSQL(request.user)

	if (sqlUserDetails == nil and config.backend_type == 'MySQL') then
		return dovecot.auth.USERDB_RESULT_USER_UNKNOWN, 'Unknown user: '..request.user 
	end

	if (sqlUserDetails ~= nil and sqlUserDetails.active == 1 and (config.backend_type == 'MySQL' or (config.backend_type == 'LDAP' and (config.ldap_sync_cron == 1 or sqlUserDetails.system_user == 1)))) then
		return dovecot.auth.USERDB_RESULT_OK, 'uid=mail gid=mail'
	end

	if (config.backend_type == 'LDAP') then
		ldap = require 'lualdap'
		ldh, err = ldap.open_simple (config.backend_uri, config.ldap_bind_dn, config.ldap_bind_password, true)
		if (ldh == nil) then
			return dovecot.auth.USERDB_RESULT_INTERNAL_FAILURE, 'LDAP open_simple failed: '..err
		end

		local ldapData = ldapSearch(config.ldap_base_dn, 'subtree', {'uid', 'nsaccountlock'}, 'mail='..sqlUserDetails.email)

		if (ldapData == nil or #ldapData == 0) then
			return dovecot.auth.USERDB_RESULT_USER_UNKNOWN, 'Unknown user: '..request.user
		end

		for i=1, #ldapData do
			local usernameStart = string.find(sqlUserDetails.email, ldapData[i].uid, 1, true)
			local usernameLength = string.len(ldapData[i].uid)
			local firstAt = string.find(sqlUserDetails.email, '@', 1, true)

			if (usernameStart == 1 and (usernameStart + usernameLength) == firstAt) then
				-- Does it matter if the account is disabled for this? Disabled should result in a bounce message... TODO?
				--if (ldapData[i].nsaccountlock) then
				--	return dovecot.auth.USERDB_RESULT_INTERNAL_FAILURE, 'User disabled: '..request.user
				--end
				if (localMail ~= nil) then
					return dovecot.auth.USERDB_RESULT_OK, 'uid=mail gid=mail user='..localMail.email
				end
				return dovecot.auth.USERDB_RESULT_OK, 'uid=mail gid=mail'
			end
		end
	end

	-- TODO? add passwd integration?
	return dovecot.auth.USERDB_RESULT_INTERNAL_FAILURE, 'Inconclusive end reached'
end
